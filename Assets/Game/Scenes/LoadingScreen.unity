  m_EditorClassIdentifier: OkapiKit::OkapiKit.TriggerOnTimer
  _showInfo: 1
  _explanation: "Every 2 seconds, trigger the actions::\n          toggles object
    LoadingIcon-4\n          toggles object LoadingIcon-1\n then, at 0,5 seconds,
    \n          toggles object LoadingIcon-1\n          toggles object LoadingIcon-2\n
    then, at 1 seconds, \n          toggles object LoadingIcon-2\n          toggles
    object LoadingIcon-3\n then, at 1,5 seconds, \n          toggles object LoadingIcon-3\n         
    toggles object LoadingIcon-4\n"
  description: 
  enableTrigger: 1
  allowRetrigger: 1
