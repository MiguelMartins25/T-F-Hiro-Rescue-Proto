  m_Name: 
  m_EditorClassIdentifier: OkapiKit::OkapiKit.TriggerOnCollision
  _showInfo: 1
  _explanation: "When a collision with a trigger with tags [Player] starts:\n         
    disables object Music\n          plays sound Thomas the Tank Engine - HQ END
    Theme Tune 1984 at volume 0,75 and at pitch 1\n then, at 8 seconds, \n         
    enables object Winning Smile\n then, at 10,5 seconds, \n          switches to
    scene MainMenu-Intro\n"
  description: 
  enableTrigger: 1
  allowRetrigger: 1
  hasPreconditions: 0
