  m_Name: 
  m_EditorClassIdentifier: OkapiKit::OkapiKit.TriggerOnCollision
  _showInfo: 1
  _explanation: "When a collision with a trigger with tags [Player] starts:\n         
    disables object CameraBoundingBox\n          enables object SpencerEncounterCameraBounds\n         
    enables component EncounterCamera (UnityEngine.Camera)\n          disables component
    Main Camera (UnityEngine.Camera)\n          enables object EncounterComponents\n         
    disables object Music\n          disables object ThomasHappy\n          enables
    object ThomasScared\n          disables object Thomas'sFaces\n          enables
    object Thomas'sFacesScared\n          plays sound Spencer's Whistle at volume
    1 and at pitch 1\n"
